# Google Gemini API Key (Pegue no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token com permissão 'repo' (Pegue em: https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Seu Repositório no GitHub no formato 'usuario/nome-do-repo'
GITHUB_REPO=seu-usuario/izzy-autodev

# Branch onde o Vercel faz o deploy automático (geralmente 'main')
GITHUB_BRANCH=main

# (Opcional) Vercel Token & Project ID para verificar status de compilação em tempo real
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
